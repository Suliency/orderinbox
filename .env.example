# ── OrderInbox AI configuration ─────────────────────────────────────────
# Copy to .env and adjust. Every variable is optional — defaults shown.

# ── Odoo ────────────────────────────────────────────────────────────────
# mock  = built-in demo catalog (zero-config demo)
# live  = real Odoo via XML-RPC (needs the sale module)
ODOO_MODE=mock
#ODOO_URL=https://your-odoo.example.com
#ODOO_DB=prod
#ODOO_USERNAME=orderinbox@yourcompany.com
#ODOO_PASSWORD=
#SEED_FILE=                      # optional custom catalog JSON (mock mode)

# ── Inbox ───────────────────────────────────────────────────────────────
# imap  = any IMAP server (Gmail, Office 365, cPanel)
# gmail = Gmail API (run `orderinbox gmail-auth` once)
# none  = manual only (drop files / use the console)
MAIL_PROVIDER=imap
#IMAP_HOST=imap.gmail.com
#IMAP_PORT=993
#IMAP_USERNAME=
#IMAP_PASSWORD=                  # Gmail: use an App Password
#IMAP_FOLDER=INBOX
#INBOX_LOOKBACK_DAYS=30
#INBOX_POLL_SECONDS=120
#GMAIL_CLIENT_ID=
#GMAIL_CLIENT_SECRET=
#GMAIL_REDIRECT_URI=http://localhost:8090/callback

# ── LLM ─────────────────────────────────────────────────────────────────
# auto   = local Ollama first, cloud fallback if configured
# ollama = local only
# cloud  = OpenAI-compatible endpoint only
# off    = deterministic parsing only (no LLM calls)
LLM_MODE=auto
#OLLAMA_URL=http://localhost:11434
#OLLAMA_MODEL=qwen2.5:1.5b
#LLM_CLOUD_BASE_URL=https://api.openai.com/v1
#LLM_CLOUD_API_KEY=
#LLM_CLOUD_MODEL=gpt-4o-mini
#LLM_TEMPERATURE=0.1
#LLM_TIMEOUT=600

# ── Matching & rules thresholds ─────────────────────────────────────────
#MATCH_THRESHOLD=80
#LOW_MATCH_THRESHOLD=60
#PRICE_DEVIATION_TOLERANCE=0.15
#CONFIDENCE_AUTO_READY=0.85
#ALLOWED_CURRENCIES=USD,CAD,EUR

# ── Console ─────────────────────────────────────────────────────────────
#WEB_HOST=0.0.0.0
#WEB_PORT=8501
WEB_PASSWORD=change-me
# Shared token for the /api/* bridge (Odoo Apps Store module sync).
# Leave empty to disable the API. Set the same value in the Odoo module
# (Settings → OrderInbox) so the two sides can talk.
#ORDERINBOX_API_TOKEN=
#LOG_LEVEL=INFO

# ── Misc ────────────────────────────────────────────────────────────────
#ORDERINBOX_HOME=/data
#ORDERINBOX_DEMO=1              # seed the demo dataset on first boot
