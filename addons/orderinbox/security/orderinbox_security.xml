<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_orderinbox_user" model="res.groups">
        <field name="name">OrderInbox: User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can review orders and approve/reject (drafts only).</field>
    </record>
    <record id="group_orderinbox_manager" model="res.groups">
        <field name="name">OrderInbox: Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_orderinbox_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Everything a user can do, plus settings and deleting orders.</field>
    </record>
</odoo>
