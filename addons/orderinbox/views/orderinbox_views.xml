<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_orderinbox_order_kanban" model="ir.ui.view">
        <field name="name">orderinbox.order.kanban</field>
        <field name="model">orderinbox.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" sort="received_at desc" create="false" delete="false"
                    class="o_orderinbox_kanban" group_expand="__group_expand_full">
                <field name="status"/>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="total"/>
                <field name="currency_id"/>
                <field name="issues"/>
                <field name="match_min_score"/>
                <field name="line_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="text-truncate" style="max-width:75%"><field name="name"/></strong>
                                <field name="total" widget="monetary" options="{'currency_field': 'currency_id'}"
                                       class="text-end"/>
                            </div>
                            <div class="text-muted small">
                                <field name="customer_id"/>
                                <span t-if="record.line_count.value"> · <t t-esc="record.line_count.value"/> lines</span>
                            </div>
                            <div t-if="record.issues.value" class="small text-danger text-truncate"
                                 title="Validation issues"><field name="issues"/></div>
                            <div class="d-flex mt4" style="gap:8px">
                                <button type="object" name="action_approve" class="btn btn-primary btn-sm px-2"
                                        invisible="status not in ('ready', 'exception')"
                                        title="Approve — create draft sales order">
                                    <fa name="check"/> Approve
                                </button>
                                <button type="object" name="action_reject" class="btn btn-secondary btn-sm px-2"
                                        invisible="status not in ('ready', 'exception')"
                                        title="Reject this order">
                                    <fa name="times"/> Reject
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_orderinbox_order_list" model="ir.ui.view">
        <field name="name">orderinbox.order.list</field>
        <field name="model">orderinbox.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="received_at"/>
                <field name="name"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'ready'"
                       decoration-warning="status == 'exception'"
                       decoration-info="status == 'sent'"
                       decoration-muted="status in ('rejected', 'failed')"/>
                <field name="customer_id"/>
                <field name="customer_score" string="Cust. score"/>
                <field name="match_min_score" string="Min SKU score"/>
                <field name="po_number"/>
                <field name="currency_id" groups="base.group_multi_currency"/>
                <field name="total" sum="Total"/>
                <field name="line_count" string="Lines"/>
                <field name="sender" optional="hide"/>
                <field name="sale_order_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_orderinbox_order_form" model="ir.ui.view">
        <field name="name">orderinbox.order.form</field>
        <field name="model">orderinbox.order</field>
        <field name="arch" type="xml">
            <form string="Incoming order">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="ready,exception,sent,rejected"/>
                    <button name="action_approve" type="object" string="Approve — create draft order"
                            class="btn-primary" invisible="status not in ('ready', 'exception')"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="status not in ('ready', 'exception')"/>
                    <button name="action_resync" type="object" string="Re-sync from appliance"
                            invisible="not appliance_synced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Subject"/></h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="customer_id"/>
                            <field name="customer_as_written"
                                   placeholder="As written in the document"/>
                            <field name="customer_score" string="Match score"/>
                            <field name="sender"/>
                        </group>
                        <group string="Purchase order">
                            <field name="po_number" placeholder="Customer PO number"/>
                            <field name="po_date"/>
                            <field name="payment_terms"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="total"/>
                            <field name="match_min_score" string="Min SKU match score"/>
                        </group>
                    </group>
                    <group string="Validation" invisible="not issues">
                        <field name="issues" nolabel="1" readonly="1"
                               placeholder="No validation issues"
                               options="{'widget': 'plaintext'}"/>
                    </group>
                    <group string="Error" invisible="not error">
                        <field name="error" nolabel="1" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="line_no"/>
                                    <field name="sku_as_written"/>
                                    <field name="product_id"/>
                                    <field name="match_score"/>
                                    <field name="match_method" optional="show"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="catalog_price" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_orderinbox_order_search" model="ir.ui.view">
        <field name="name">orderinbox.order.search</field>
        <field name="model">orderinbox.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="po_number"/>
                <field name="sender"/>
                <filter string="Ready for approval" name="ready" domain="[('status', '=', 'ready')]"/>
                <filter string="Exceptions" name="exception" domain="[('status', '=', 'exception')]"/>
                <separator/>
                <filter string="Draft created" name="sent" domain="[('status', '=', 'sent')]"/>
                <filter string="Rejected" name="rejected" domain="[('status', '=', 'rejected')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter string="From appliance" name="synced" domain="[('appliance_synced', '=', True)]"/>
                <group expand="0" string="Group by">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Received (month)" name="group_month"
                            context="{'group_by': 'received_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_orderinbox_orders" model="ir.actions.act_window">
        <field name="name">Incoming orders</field>
        <field name="res_model">orderinbox.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_orderinbox_order_search"/>
        <field name="context">{'search_default_ready': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No incoming orders yet
            </p>
            <p>
                Orders appear here when the OrderInbox AI appliance syncs them,
                or you can create one manually to test the flow.
            </p>
        </field>
    </record>

</odoo>
