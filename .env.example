# ── OrderInbox AI configuration ─────────────────────────────────────────
# Copy to .env and adjust. Every variable is optional — defaults shown.

# ── Odoo ────────────────────────────────────────────────────────────────
# mock  = built-in demo catalog (zero-config demo)
# live  = real Odoo via XML-RPC (needs the sale module)
ODOO_MODE=mock
#ODOO_URL=https://your-odoo.example.com
#ODOO_DB=prod
#ODOO_USERNAME=orderinbox@yourcompany.com
#ODOO_PASSWORD=
#SEED_FILE=                      # optional custom catalog JSON (mock mode)

# ── Inbox ───────────────────────────────────────────────────────────────
# imap  = any IMAP server (Gmail, Office 365, cPanel)
# gmail = Gmail API (run `orderinbox gmail-auth` once)
# none  = manual only (drop files / use the console)
MAIL_PROVIDER=imap
#IMAP_HOST=imap.gmail.com
#IMAP_PORT=993
#IMAP_USERNAME=
#IMAP_PASSWORD=                  # Gmail: use an App Password
#IMAP_FOLDER=INBOX
#INBOX_LOOKBACK_DAYS=30
#INBOX_POLL_SECONDS=120
#GMAIL_CLIENT_ID=
#GMAIL_CLIENT_SECRET=
#GMAIL_REDIRECT_URI=http://localhost:8090/callback

# ── Model gateway (the Strata integration) ──────────────────────────────
# LLM_MODE gates which *class* of provider is enabled:
#   auto   = local providers first, cloud fallback if configured
#   ollama = local Ollama only
#   cloud  = cloud / remote providers only
#   off    = deterministic parsing only (no model calls)
LLM_MODE=auto

# Local backends. Ollama is the zero-config default (small model).
#
# Strata (https://github.com/Niko1221/Strata) is the main local model: a 125B
# Qwen3.8-Flash-Next on one 12 GB+ NVIDIA/AMD card with 32-64 GB RAM. When
# STRATA_URL is set, Strata takes the volume and Ollama becomes the fallback /
# second model. Run it with docker-compose.strata.yml, or natively with
# Strata's ./setup.sh (then from a container use
# http://host.docker.internal:8080/v1 and add
# `extra_hosts: ["host.docker.internal:host-gateway"]` on Linux).
#OLLAMA_URL=http://localhost:11434
#OLLAMA_MODEL=qwen2.5:1.5b
#STRATA_URL=http://127.0.0.1:8080/v1
#STRATA_MODEL=strata               # Strata accepts any name
#STRATA_API_KEY=                   # only if Strata was started with --api-key
#STRATA_VISION=0                   # also auto-detected from Strata's /health
#STRATA_REASONING_EFFORT=low       # none | low | medium | high (Strata default: high)
#STRATA_REASONING_BUDGET=0         # hard cap on thinking tokens, 0 = none
#
# vLLM: any OpenAI-compatible server — e.g. a second GPU / DGX Spark running
# the independent verifier model.
#VLLM_URL=http://spark2:8000/v1
#VLLM_MODEL=qwen2.5-32b-instruct
#VLLM_API_KEY=
#VLLM_VISION=0

# Cloud backends (any OpenAI-compatible endpoint, plus Anthropic / Gemini).
#LLM_CLOUD_BASE_URL=https://api.openai.com/v1
#LLM_CLOUD_API_KEY=
#LLM_CLOUD_MODEL=gpt-4o-mini
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-3-5-sonnet-latest
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-1.5-pro
#LLM_TEMPERATURE=0.1
#LLM_TIMEOUT=600

# Confidence-tier escalation cut-points (proposal Section 10). A value at or
# above a threshold reaches that tier: auto / second local check / cloud /
# human. Lower the numbers to be more conservative.
#ESCALATE_AUTO=0.95
#ESCALATE_VERIFY=0.80
#ESCALATE_CLOUD=0.60
# Producer/verifier second pass (Section 11) and cloud escalation (Section 3).
#USE_PRODUCER_VERIFIER=1
#USE_CLOUD_ESCALATION=1

# ── Matching & rules thresholds ─────────────────────────────────────────
#MATCH_THRESHOLD=80
#LOW_MATCH_THRESHOLD=60
#PRICE_DEVIATION_TOLERANCE=0.15
#CONFIDENCE_AUTO_READY=0.85
#ALLOWED_CURRENCIES=USD,CAD,EUR
# Minimum acceptable freight margin (%) before a quote needs review/approval.
#FREIGHT_MARGIN_THRESHOLD=10

# ── Console ─────────────────────────────────────────────────────────────
#WEB_HOST=0.0.0.0
#WEB_PORT=8501
WEB_PASSWORD=change-me
# Shared token for the /api/* bridge (Odoo Apps Store module sync).
# Leave empty to disable the API. Set the same value in the Odoo module
# (Settings → OrderInbox) so the two sides can talk.
#ORDERINBOX_API_TOKEN=
#LOG_LEVEL=INFO

# ── Misc ────────────────────────────────────────────────────────────────
#ORDERINBOX_HOME=/data
#ORDERINBOX_DEMO=1              # seed the demo dataset on first boot
