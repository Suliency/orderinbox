<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_orderinbox" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.orderinbox</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <block name="orderinbox" title="OrderInbox AI"
                       help="Review queue for emailed customer purchase orders, synced from the OrderInbox AI appliance.">
                    <setting id="orderinbox_appliance">
                        <div class="content-group">
                            <div class="row">
                                <label for="orderinbox_appliance_url"
                                       string="Appliance URL" class="col-lg-3 o_light_label"/>
                                <field name="orderinbox_appliance_url"
                                       placeholder="http://appliance.lan:8501"/>
                            </div>
                            <div class="row">
                                <label for="orderinbox_api_token"
                                       string="API token" class="col-lg-3 o_light_label"/>
                                <field name="orderinbox_api_token"
                                       placeholder="Must match ORDERINBOX_API_TOKEN on the appliance"/>
                            </div>
                            <div class="row mt8"
                                 invisible="not orderinbox_appliance_url">
                                <div class="col-lg-9 alert alert-info" role="alert">
                                    Leave the URL empty to use this module standalone: create
                                    orders manually (or via the push endpoint) and approve them
                                    here to build draft sales orders in Odoo.
                                </div>
                            </div>
                        </div>
                    </setting>
                    <setting id="orderinbox_rules">
                        <div class="content-group">
                            <div class="row">
                                <label for="orderinbox_match_threshold"
                                       string="Match threshold" class="col-lg-3 o_light_label"/>
                                <field name="orderinbox_match_threshold"/>
                                <span class="col-lg-3 text-muted">score ≥ this is auto-matched (0–100)</span>
                            </div>
                            <div class="row">
                                <label for="orderinbox_price_tolerance"
                                       string="Price tolerance" class="col-lg-3 o_light_label"/>
                                <field name="orderinbox_price_tolerance"/>
                                <span class="col-lg-3 text-muted">quoted vs catalog price, %</span>
                            </div>
                            <div class="row">
                                <label for="orderinbox_currencies"
                                       string="Currencies" class="col-lg-3 o_light_label"/>
                                <field name="orderinbox_currencies"
                                       placeholder="USD,CAD,EUR"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
