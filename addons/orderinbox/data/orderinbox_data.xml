<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_orderinbox_sync" model="ir.cron">
        <field name="name">OrderInbox: sync orders from appliance</field>
        <field name="model_id" ref="model_orderinbox_order"/>
        <field name="state">code</field>
        <field name="code">model.sync_from_appliance()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
